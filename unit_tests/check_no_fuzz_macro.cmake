file(GLOB_RECURSE build_files "${BUILD_DIR}/CMakeCache.txt" "${BUILD_DIR}/flags.make")
list(LENGTH build_files build_file_count)
if(build_file_count EQUAL 0)
    message(FATAL_ERROR "no CMakeCache.txt or flags.make under ${BUILD_DIR}")
endif()
set(offenders "")
foreach(build_file IN LISTS build_files)
    file(STRINGS "${build_file}" hits REGEX "FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION")
    if(hits)
        list(APPEND offenders "${build_file}")
    endif()
endforeach()
if(offenders)
    message(FATAL_ERROR "FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION is defined in a build that is not a fuzzing build: ${offenders}")
endif()
